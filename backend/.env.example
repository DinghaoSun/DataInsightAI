# Copy only if .env does not exist; replace placeholders locally.
# root is the code's local default, not a production recommendation.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=datainsightai

# Supply your own key. Never commit the real .env file.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
# Current code default; confirm model availability for your account.
DEEPSEEK_MODEL=deepseek-v4-flash
